{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1140px"
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "customGradient": true,
      "palette": [
        { "slug": "base", "color": "#FBF8F1", "name": "Base" },
        { "slug": "surface", "color": "#F3ECDF", "name": "Surface" },
        { "slug": "contrast", "color": "#2E2A24", "name": "Contrast" },
        { "slug": "muted", "color": "#8A7E6A", "name": "Muted" },
        { "slug": "primary", "color": "#B08D57", "name": "Primary" },
        { "slug": "accent", "color": "#9AA67E", "name": "Accent" },
        { "slug": "line", "color": "#E4DAC8", "name": "Line" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "cormorant",
          "name": "Cormorant Garamond",
          "fontFamily": "\"Cormorant Garamond\", \"Times New Roman\", serif"
        },
        {
          "slug": "eb-garamond",
          "name": "EB Garamond",
          "fontFamily": "\"EB Garamond\", Georgia, serif"
        },
        {
          "slug": "great-vibes",
          "name": "Great Vibes",
          "fontFamily": "\"Great Vibes\", \"Brush Script MT\", cursive"
        },
        {
          "slug": "tenor-sans",
          "name": "Tenor Sans",
          "fontFamily": "\"Tenor Sans\", \"Helvetica Neue\", sans-serif"
        },
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "\"Inter\", \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "jost",
          "name": "Jost",
          "fontFamily": "\"Jost\", \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "pinyon-script",
          "name": "Pinyon Script",
          "fontFamily": "\"Pinyon Script\", \"Brush Script MT\", cursive"
        },
        {
          "slug": "mulish",
          "name": "Mulish",
          "fontFamily": "\"Mulish\", \"Helvetica Neue\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
        { "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.6rem" } },
        { "slug": "x-large", "name": "Extra large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3rem" } },
        { "slug": "xx-large", "name": "Display", "size": "4rem", "fluid": { "min": "2.75rem", "max": "5.5rem" } },
        { "slug": "huge", "name": "Hero", "size": "6rem", "fluid": { "min": "3.5rem", "max": "8rem" } }
      ]
    },
    "spacing": {
      "customSpacingSize": true,
      "units": ["px", "em", "rem", "vw", "vh", "%", "svh"],
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "name": "1 — Tight", "size": "0.75rem" },
        { "slug": "30", "name": "2 — Small", "size": "1.25rem" },
        { "slug": "40", "name": "3 — Base", "size": "2rem" },
        { "slug": "50", "name": "4 — Medium", "size": "3rem" },
        { "slug": "60", "name": "5 — Large", "size": "clamp(3.5rem, 8vw, 6rem)" },
        { "slug": "70", "name": "6 — Section", "size": "clamp(5rem, 12vw, 9rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--jost)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.75",
      "letterSpacing": "0.005em"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "clamp(1.25rem, 5vw, 2.5rem)",
        "right": "clamp(1.25rem, 5vw, 2.5rem)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--cormorant)",
          "fontWeight": "500",
          "lineHeight": "1.15",
          "letterSpacing": "0.01em"
        },
        "color": { "text": "var(--wp--preset--color--contrast)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "fontWeight": "400" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "textDecoration": "none" },
        ":hover": { "typography": { "textDecoration": "underline" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "2.25rem", "right": "2.25rem" } },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--jost)",
          "fontSize": "0.8rem",
          "fontWeight": "500",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase"
        },
        ":hover": { "color": { "background": "var(--wp--preset--color--contrast)" } }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--cormorant)",
          "fontSize": "1.5rem",
          "fontWeight": "500",
          "letterSpacing": "0.2em",
          "textTransform": "uppercase"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    {
      "name": "page-invite",
      "title": "Wedding invitation (full width)",
      "postTypes": ["page"]
    }
  ]
}
