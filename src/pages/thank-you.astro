---
/**
 * Generic thank-you page, shared by every client site. The forms redirect here
 * with ?type=rsvp|contact&lang=en|he; a tiny script shows the right localized
 * message. Self-contained (links the shared /site.css).
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Thank you</title>
    <link rel="stylesheet" href="/site.css" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="bg-bg text-ink">
    <main class="flex min-h-screen items-center justify-center px-6 py-24 text-center">
      <div class="max-w-lg">
        <h1 id="ty-title" class="font-heading text-4xl text-primary sm:text-5xl">Thank you!</h1>
        <p id="ty-body" class="mt-5 text-lg text-muted"></p>
        <div class="mt-10"><a id="ty-back" href="/" class="btn-outline">Back to the invitation</a></div>
      </div>
    </main>

    <script is:inline>
      const STR = {
        en: {
          rsvpTitle: "Thank you!",
          rsvpBody: "Your RSVP has been received. We can't wait to celebrate with you.",
          contactTitle: "Message sent",
          contactBody: "Thank you for reaching out — we'll get back to you soon.",
          back: "Back to the invitation",
        },
        he: {
          rsvpTitle: "תודה רבה!",
          rsvpBody: "אישור ההגעה התקבל. מחכים לחגוג אתכם!",
          contactTitle: "ההודעה נשלחה",
          contactBody: "תודה שפניתם אלינו — נחזור אליכם בהקדם.",
          back: "חזרה להזמנה",
        },
        fr: {
          rsvpTitle: "Merci !",
          rsvpBody: "Votre réponse a bien été reçue. Nous avons hâte de célébrer avec vous.",
          contactTitle: "Message envoyé",
          contactBody: "Merci de nous avoir écrit — nous vous répondrons bientôt.",
          back: "Retour à l'invitation",
        },
      };
      const q = new URLSearchParams(location.search);
      const reqLang = q.get("lang");
      const lang = reqLang === "he" ? "he" : reqLang === "fr" ? "fr" : "en";
      const isContact = q.get("type") === "contact";
      const s = STR[lang];
      if (lang === "he") document.documentElement.setAttribute("dir", "rtl");
      document.documentElement.setAttribute("lang", lang);
      document.getElementById("ty-title").textContent = isContact ? s.contactTitle : s.rsvpTitle;
      document.getElementById("ty-body").textContent = isContact ? s.contactBody : s.rsvpBody;
      document.getElementById("ty-back").textContent = s.back;
    </script>
  </body>
</html>
