---
/**
 * Generic thank-you page, shared by every client site. The forms redirect here
 * with ?type=rsvp|contact&lang=en|he; a tiny script shows the right localized
 * message. Self-contained (links the shared /site.css).
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Thank you</title>
    <link rel="stylesheet" href="/site.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
    />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="bg-pl-canvas text-pl-ink">
    <main class="flex min-h-screen items-center justify-center px-6 py-20 text-center">
      <div class="pl-card mx-auto w-full max-w-lg px-8 py-12 sm:px-12 sm:py-14" style="box-shadow: var(--shadow-pl-lg);">
        <!-- Gold seal with a check + small flourish -->
        <div class="mx-auto mb-7 flex h-16 w-16 items-center justify-center rounded-full bg-pl-wash ring-1 ring-pl-gold/25">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-pl-gold" aria-hidden="true">
            <path d="M5 12.5 10 17.5 19 7" />
          </svg>
        </div>
        <div class="mb-5 flex items-center justify-center gap-3 text-pl-gold/60" aria-hidden="true">
          <span class="h-px w-10 bg-pl-gold/30"></span>
          <span class="text-xs">✦</span>
          <span class="h-px w-10 bg-pl-gold/30"></span>
        </div>
        <h1 id="ty-title" class="font-pl-display text-4xl font-medium text-pl-ink sm:text-5xl">Thank you!</h1>
        <p id="ty-body" class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-pl-ink-2"></p>
        <div class="mt-9">
          <a id="ty-back" href="/" class="pl-btn-ghost border border-pl-line px-6 py-2.5">Back to the invitation</a>
        </div>
      </div>
    </main>

    <script is:inline>
      const STR = {
        en: {
          rsvpTitle: "Thank you!",
          rsvpBody: "Your RSVP has been received. We can't wait to celebrate with you.",
          contactTitle: "Message sent",
          contactBody: "Thank you for reaching out — we'll get back to you soon.",
          back: "Back to the invitation",
        },
        he: {
          rsvpTitle: "תודה רבה!",
          rsvpBody: "אישור ההגעה התקבל. מחכים לחגוג אתכם!",
          contactTitle: "ההודעה נשלחה",
          contactBody: "תודה שפניתם אלינו — נחזור אליכם בהקדם.",
          back: "חזרה להזמנה",
        },
        fr: {
          rsvpTitle: "Merci !",
          rsvpBody: "Votre réponse a bien été reçue. Nous avons hâte de célébrer avec vous.",
          contactTitle: "Message envoyé",
          contactBody: "Merci de nous avoir écrit — nous vous répondrons bientôt.",
          back: "Retour à l'invitation",
        },
      };
      const q = new URLSearchParams(location.search);
      const reqLang = q.get("lang");
      const lang = reqLang === "he" ? "he" : reqLang === "fr" ? "fr" : "en";
      const isContact = q.get("type") === "contact";
      const s = STR[lang];
      if (lang === "he") document.documentElement.setAttribute("dir", "rtl");
      document.documentElement.setAttribute("lang", lang);
      document.getElementById("ty-title").textContent = isContact ? s.contactTitle : s.rsvpTitle;
      document.getElementById("ty-body").textContent = isContact ? s.contactBody : s.rsvpBody;
      document.getElementById("ty-back").textContent = s.back;
    </script>
  </body>
</html>
