---
/**
 * Media library page — a reusable bank of all uploaded images, shared across
 * every site. Rendered as a HeroUI React island (client:only="react") that
 * loads from /api/media (admin-protected).
 */
import Media from "../../components/Media.tsx";
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Paperly · Media library</title>
    <link rel="stylesheet" href="/heroui.css" />
    <link rel="stylesheet" href="/site.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
    />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-pl-canvas font-pl-ui text-pl-ink">
    <Media client:only="react">
      <main slot="fallback" class="mx-auto max-w-7xl px-4 py-8 sm:px-8 sm:py-10">
        <p class="text-pl-muted">Loading…</p>
      </main>
    </Media>
  </body>
</html>
