---
/**
 * Per-site responses view — RSVPs + contact messages for ?slug=<slug>.
 * Data loads client-side from /api/responses (admin-protected).
 */
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Paperly · Responses</title>
    <link rel="stylesheet" href="/site.css" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900">
    <header class="flex flex-wrap items-center gap-3 bg-neutral-900 px-5 py-3 text-white">
      <a href="/admin" class="rounded-md border border-white/30 px-2.5 py-1 text-xs hover:bg-white/10">← Sites</a>
      <span class="font-semibold tracking-wide">Responses</span>
      <span id="pl-title" class="rounded bg-white/10 px-2 py-0.5 text-xs"></span>
      <a id="pl-csv" href="#" class="ms-auto rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-neutral-900 hover:bg-neutral-200">Download CSV</a>
    </header>

    <main class="mx-auto max-w-7xl px-5 py-8 sm:px-8">
      <div id="pl-responses"><p class="text-neutral-400">Loading…</p></div>
    </main>

    <script>
      import { initResponses } from "../../lib/responses";
      initResponses();
    </script>
  </body>
</html>
