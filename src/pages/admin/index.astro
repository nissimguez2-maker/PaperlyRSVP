---
/**
 * Control panel dashboard. Static shell; data loads client-side from the admin
 * APIs (which require the admin password — prompted on first load). Lists all
 * sites grouped by Live / In progress / Paused / Past as rich cards, with an
 * in-page "New site" form.
 */
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Paperly · Control panel</title>
    <link rel="stylesheet" href="/site.css" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900">
    <header class="flex flex-wrap items-center gap-3 bg-neutral-900 px-5 py-3 text-white">
      <span class="font-semibold tracking-wide">Paperly</span>
      <span class="rounded bg-white/10 px-2 py-0.5 text-xs">Control panel</span>
      <nav class="ms-4 flex items-center gap-4 text-sm text-neutral-300">
        <a href="/admin" class="text-white">Sites</a>
        <a href="/admin/media" class="hover:text-white">Media library</a>
      </nav>
      <button id="pl-new" class="ms-auto rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-neutral-900 hover:bg-neutral-200">+ New site</button>
    </header>

    <main class="mx-auto max-w-7xl px-5 py-8 sm:px-8">
      <div id="pl-sites"><p class="text-neutral-400">Loading…</p></div>
    </main>

    <!-- In-page "New site" form (replaces the old pop-ups) -->
    <div id="pl-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
      <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl">
        <h2 class="mb-1 text-lg font-semibold">Create a new site</h2>
        <p class="mb-4 text-sm text-neutral-500">You can change everything later in the editor.</p>

        <label class="mb-1 block text-xs font-medium text-neutral-500">Site name</label>
        <input id="pl-m-title" type="text" placeholder="e.g. Smith Wedding" class="mb-4 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm outline-none focus:border-neutral-900" />

        <div class="mb-4 grid grid-cols-2 gap-3">
          <div>
            <label class="mb-1 block text-xs font-medium text-neutral-500">Language</label>
            <select id="pl-m-lang" class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm">
              <option value="en">English</option>
              <option value="he">Hebrew (עברית)</option>
            </select>
          </div>
          <div>
            <label class="mb-1 block text-xs font-medium text-neutral-500">Direction</label>
            <select id="pl-m-dir" class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm">
              <option value="ltr">Left → Right</option>
              <option value="rtl">Right → Left</option>
            </select>
          </div>
        </div>

        <label class="mb-1 block text-xs font-medium text-neutral-500">Event type</label>
        <select id="pl-m-type" class="mb-4 w-full rounded-md border border-neutral-300 px-3 py-2 text-sm">
          <option value="wedding">Wedding</option>
          <option value="bar-mitzvah">Bar Mitzvah</option>
          <option value="bat-mitzvah">Bat Mitzvah</option>
          <option value="engagement">Engagement</option>
          <option value="henna">Henna</option>
          <option value="brit-milah">Brit Milah</option>
          <option value="shabbat-chattan">Shabbat Chattan</option>
          <option value="private">Private celebration</option>
        </select>

        <p id="pl-m-error" class="mb-3 text-sm text-red-600"></p>
        <div class="flex justify-end gap-2">
          <button id="pl-m-cancel" class="rounded-md px-4 py-2 text-sm text-neutral-600 hover:bg-neutral-100">Cancel</button>
          <button id="pl-m-create" class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700">Create &amp; edit</button>
        </div>
      </div>
    </div>

    <script>
      import { initDashboard } from "../../lib/dashboard";
      initDashboard();
    </script>
  </body>
</html>
