---
/**
 * The published invitation. The entire page body is produced by the shared
 * renderer (src/lib/render.ts) — the SAME code the Studio editor uses for its
 * live preview, so what you design is exactly what ships.
 *
 * To change how a section looks, edit src/lib/render.ts (affects site + editor).
 * To change a specific client's words/design, edit their content.json / use the
 * Studio.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { content } from "../lib/site";
import { renderApp, resolveLabels } from "../lib/render";

const appHtml = renderApp(content, {
  labels: resolveLabels(content),
  turnstileSiteKey: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
});
---

<BaseLayout>
  <Fragment set:html={appHtml} />
</BaseLayout>

<script is:inline>
  // Progressive enhancement: hide the guest count / names / dietary fields when
  // a guest selects "declines". No framework needed.
  document.querySelectorAll("input[data-attending]").forEach((el) => {
    el.addEventListener("change", (e) => {
      const declined = e.target.value === "no";
      document.querySelectorAll("[data-guest-fields]").forEach((g) => {
        g.style.display = declined ? "none" : "";
      });
    });
  });

  // Hide the floating RSVP button while the RSVP section is on screen.
  const fab = document.getElementById("pl-fab");
  const rsvp = document.getElementById("rsvp");
  if (fab && rsvp && "IntersectionObserver" in window) {
    new IntersectionObserver(
      (entries) => entries.forEach((en) => fab.classList.toggle("is-hidden", en.isIntersecting)),
    ).observe(rsvp);
  }
</script>
