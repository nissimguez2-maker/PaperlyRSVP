---
/**
 * Location — venue name, address, an optional embedded map and a directions
 * button (Google/Waze/Apple Maps). Edit under `sections.location`.
 */
import type { LocationSection } from "../lib/types";

interface Props {
  id: string;
  data: LocationSection;
  directionsLabel: string;
}
const { id, data, directionsLabel } = Astro.props;
---

<section id={id} class="bg-bg py-20 sm:py-28">
  <div class="container-prose">
    <div class="mb-12 text-center">
      {data.eyebrow && <p class="eyebrow mb-3">{data.eyebrow}</p>}
      {data.title && <h2 class="section-title">{data.title}</h2>}
    </div>

    <div class="grid items-center gap-10 md:grid-cols-2">
      <div class="text-center md:text-start">
        {data.venue && <h3 class="font-heading text-3xl text-primary">{data.venue}</h3>}
        {data.address && (
          <p class="mt-3 whitespace-pre-line text-lg text-muted">{data.address}</p>
        )}
        {data.body && <p class="mt-4 text-muted">{data.body}</p>}
        {data.mapUrl && (
          <div class="mt-6">
            <a href={data.mapUrl} target="_blank" rel="noopener" class="btn-outline">
              {directionsLabel}
            </a>
          </div>
        )}
      </div>

      {data.mapEmbedUrl && (
        <div class="overflow-hidden rounded-2xl border border-line shadow-sm">
          <iframe
            src={data.mapEmbedUrl}
            title={data.venue ?? "Map"}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-72 w-full md:h-80"
          ></iframe>
        </div>
      )}
    </div>
  </div>
</section>
