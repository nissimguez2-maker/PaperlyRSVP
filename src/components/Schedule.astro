---
/**
 * Schedule / order of the day — a vertical timeline. Great for ceremony,
 * reception, chuppah, candle-lighting, etc. Edit under `sections.schedule`.
 * The border sits on the inline-start edge so it mirrors correctly in RTL.
 */
import type { ScheduleSection } from "../lib/types";

interface Props {
  id: string;
  data: ScheduleSection;
}
const { id, data } = Astro.props;
---

<section id={id} class="bg-surface py-20 sm:py-28">
  <div class="container-prose">
    <div class="mb-12 text-center">
      {data.eyebrow && <p class="eyebrow mb-3">{data.eyebrow}</p>}
      {data.title && <h2 class="section-title">{data.title}</h2>}
      {data.body && <p class="mx-auto mt-4 max-w-2xl text-muted">{data.body}</p>}
    </div>

    <ol class="mx-auto max-w-2xl space-y-8 border-s-2 border-line ps-8">
      {data.items.map((item) => (
        <li class="relative">
          <span class="absolute -start-[calc(2rem+5px)] top-2 h-3 w-3 rounded-full bg-accent"></span>
          {item.time && (
            <p class="text-sm uppercase tracking-[0.2em] text-accent">{item.time}</p>
          )}
          <h3 class="mt-1 font-heading text-2xl text-primary">{item.title}</h3>
          {item.description && <p class="mt-1 text-muted">{item.description}</p>}
        </li>
      ))}
    </ol>
  </div>
</section>
