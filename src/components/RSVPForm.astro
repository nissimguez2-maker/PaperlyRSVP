---
/**
 * RSVP form.
 *
 * Posts as a normal HTML form to the Cloudflare Pages Function at /api/rsvp,
 * which validates, checks Turnstile, stores the row in D1, and redirects to
 * /thank-you. Working without client JS keeps it robust; a tiny enhancement
 * script just hides the guest fields when someone declines.
 *
 * All visible text comes from `labels` (resolved from the site language +
 * per-site overrides in content.json) so this component is fully bilingual.
 */
import type { RsvpSection } from "../lib/types";
import type { Dictionary } from "../lib/i18n";

interface Props {
  id: string;
  data: RsvpSection;
  siteId: string;
  language: string;
  labels: Dictionary;
  turnstileSiteKey?: string;
}
const { id, data, siteId, language, labels, turnstileSiteKey } = Astro.props;
const req = labels.required;
---

<section id={id} class="bg-bg py-20 sm:py-28">
  <div class="container-prose max-w-2xl">
    <div class="mb-10 text-center">
      {data.eyebrow && <p class="eyebrow mb-3">{data.eyebrow}</p>}
      {data.title && <h2 class="section-title">{data.title}</h2>}
      {data.body && <p class="mx-auto mt-4 max-w-xl text-muted">{data.body}</p>}
      {data.deadlineNote && (
        <p class="mt-4 text-sm uppercase tracking-[0.2em] text-accent">{data.deadlineNote}</p>
      )}
    </div>

    <form method="POST" action="/api/rsvp" class="space-y-6 rounded-2xl border border-line bg-surface p-6 sm:p-10 shadow-sm">
      <!-- Context sent with every submission and stored in D1. -->
      <input type="hidden" name="site_id" value={siteId} />
      <input type="hidden" name="language" value={language} />

      <div>
        <label class="field-label" for="rsvp-name">{labels.fullName} <span class="text-accent" title={req}>*</span></label>
        <input class="field-input" id="rsvp-name" name="full_name" type="text" required autocomplete="name" />
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="field-label" for="rsvp-email">{labels.email}</label>
          <input class="field-input" id="rsvp-email" name="email" type="email" autocomplete="email" />
        </div>
        <div>
          <label class="field-label" for="rsvp-phone">{labels.phone}</label>
          <input class="field-input" id="rsvp-phone" name="phone" type="tel" autocomplete="tel" />
        </div>
      </div>

      <fieldset>
        <legend class="field-label">{labels.attending} <span class="text-accent" title={req}>*</span></legend>
        <div class="mt-1 flex flex-wrap gap-3">
          <label class="flex flex-1 cursor-pointer items-center gap-3 rounded-lg border border-line bg-bg px-4 py-3 has-[:checked]:border-accent has-[:checked]:bg-accent/5">
            <input type="radio" name="attending" value="yes" required data-attending="yes" class="accent-[var(--site-accent)]" />
            <span>{labels.attendingYes}</span>
          </label>
          <label class="flex flex-1 cursor-pointer items-center gap-3 rounded-lg border border-line bg-bg px-4 py-3 has-[:checked]:border-accent has-[:checked]:bg-accent/5">
            <input type="radio" name="attending" value="no" data-attending="no" class="accent-[var(--site-accent)]" />
            <span>{labels.attendingNo}</span>
          </label>
        </div>
      </fieldset>

      <!-- Guest fields: hidden automatically when "declines" is selected. -->
      <div data-guest-fields class="space-y-6">
        <div>
          <label class="field-label" for="rsvp-guests">{labels.guests}</label>
          <input class="field-input" id="rsvp-guests" name="guests" type="number" min="0" inputmode="numeric" value="1" />
        </div>
        <div>
          <label class="field-label" for="rsvp-guest-names">{labels.guestNames}</label>
          <textarea class="field-input" id="rsvp-guest-names" name="guest_names" rows="2" placeholder={labels.guestNamesHint}></textarea>
        </div>
        <div>
          <label class="field-label" for="rsvp-dietary">{labels.dietary}</label>
          <textarea class="field-input" id="rsvp-dietary" name="dietary" rows="2" placeholder={labels.dietaryHint}></textarea>
        </div>
      </div>

      <div>
        <label class="field-label" for="rsvp-message">{labels.message}</label>
        <textarea class="field-input" id="rsvp-message" name="message" rows="3"></textarea>
      </div>

      {turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
      )}

      <button type="submit" class="btn-primary w-full">{labels.rsvpSubmit}</button>
    </form>
  </div>
</section>

<script is:inline>
  // Progressive enhancement: when a guest declines, the guest count / names /
  // dietary fields are not relevant, so we hide them. No framework needed.
  document.querySelectorAll('input[data-attending]').forEach((el) => {
    el.addEventListener('change', (e) => {
      const declined = e.target.value === 'no';
      document.querySelectorAll('[data-guest-fields]').forEach((g) => {
        g.style.display = declined ? 'none' : '';
      });
    });
  });
</script>
