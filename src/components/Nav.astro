---
/**
 * Sticky top navigation. Links are usually in-page anchors (e.g. "#rsvp").
 * Edit them under `nav` in content.json. Works in both LTR and RTL because it
 * uses logical flex direction and a centered layout.
 */
import type { NavItem } from "../lib/types";

interface Props {
  brand: string;
  items?: NavItem[];
}
const { brand, items = [] } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-bg/80 backdrop-blur">
  <nav class="container-prose flex items-center justify-between gap-4 py-4">
    <a href="#top" class="font-heading text-lg tracking-wide text-primary">{brand}</a>

    {items.length > 0 && (
      <>
        <ul class="hidden items-center gap-7 md:flex">
          {items.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm tracking-wide text-muted transition-colors hover:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Mobile menu: a tiny native <details> so there is no JS framework. -->
        <details class="relative md:hidden">
          <summary class="cursor-pointer list-none text-2xl leading-none text-primary">☰</summary>
          <ul class="absolute end-0 mt-3 w-52 rounded-xl border border-line bg-surface p-2 shadow-lg">
            {items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-lg px-3 py-2 text-sm text-ink hover:bg-bg hover:text-accent"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </>
    )}
  </nav>
</header>
