---
/**
 * Event details — an intro paragraph, an optional invitation image, and a tidy
 * grid of key facts (date, venue, dress code, …). Edit under
 * `sections.eventDetails` in content.json.
 */
import type { EventDetailsSection } from "../lib/types";

interface Props {
  id: string;
  data: EventDetailsSection;
}
const { id, data } = Astro.props;
---

<section id={id} class="bg-bg py-20 sm:py-28">
  <div class="container-prose">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div>
        {data.eyebrow && <p class="eyebrow mb-3">{data.eyebrow}</p>}
        {data.title && <h2 class="section-title mb-6">{data.title}</h2>}
        {data.body && (
          <p class="whitespace-pre-line text-lg leading-relaxed text-muted">{data.body}</p>
        )}

        {data.items && data.items.length > 0 && (
          <dl class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {data.items.map((item) => (
              <div class="border-t border-line pt-4">
                <dt class="text-xs uppercase tracking-[0.2em] text-accent">{item.label}</dt>
                <dd class="mt-1 text-lg text-ink">{item.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      {data.image && (
        <div class="order-first md:order-last">
          <img
            src={data.image}
            alt={data.title ?? ""}
            class="mx-auto w-full max-w-md rounded-2xl border border-line object-cover shadow-sm"
          />
        </div>
      )}
    </div>
  </div>
</section>
