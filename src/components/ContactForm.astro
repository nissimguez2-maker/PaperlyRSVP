---
/**
 * Contact form — name, email, message. Posts to /api/contact (Cloudflare Pages
 * Function), which validates, checks Turnstile, stores the row in D1, and
 * redirects to /thank-you?type=contact. Bilingual via `labels`.
 */
import type { ContactSection } from "../lib/types";
import type { Dictionary } from "../lib/i18n";

interface Props {
  id: string;
  data: ContactSection;
  siteId: string;
  language: string;
  labels: Dictionary;
  turnstileSiteKey?: string;
}
const { id, data, siteId, language, labels, turnstileSiteKey } = Astro.props;
const req = labels.required;
---

<section id={id} class="bg-surface py-20 sm:py-28">
  <div class="container-prose max-w-xl">
    <div class="mb-10 text-center">
      {data.eyebrow && <p class="eyebrow mb-3">{data.eyebrow}</p>}
      {data.title && <h2 class="section-title">{data.title}</h2>}
      {data.body && <p class="mx-auto mt-4 text-muted">{data.body}</p>}
    </div>

    <form method="POST" action="/api/contact" class="space-y-6 rounded-2xl border border-line bg-bg p-6 sm:p-10 shadow-sm">
      <input type="hidden" name="site_id" value={siteId} />
      <input type="hidden" name="language" value={language} />

      <div>
        <label class="field-label" for="contact-name">{labels.contactName} <span class="text-accent" title={req}>*</span></label>
        <input class="field-input" id="contact-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div>
        <label class="field-label" for="contact-email">{labels.contactEmail}</label>
        <input class="field-input" id="contact-email" name="email" type="email" autocomplete="email" />
      </div>
      <div>
        <label class="field-label" for="contact-message">{labels.contactMessage} <span class="text-accent" title={req}>*</span></label>
        <textarea class="field-input" id="contact-message" name="message" rows="4" required></textarea>
      </div>

      {turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
      )}

      <button type="submit" class="btn-primary w-full">{labels.contactSubmit}</button>
    </form>
  </div>
</section>
