---
/**
 * Footer — a quiet closing line. Edit under `footer` in content.json.
 */
import type { FooterContent } from "../lib/types";

interface Props {
  data?: FooterContent;
}
const { data } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface py-12 text-center">
  <div class="container-prose">
    {data?.message && <p class="font-heading text-2xl text-primary">{data.message}</p>}
    {data?.credit && <p class="mt-3 text-sm text-muted">{data.credit}</p>}
    <p class="mt-3 text-xs uppercase tracking-[0.2em] text-muted/70">© {year}</p>
  </div>
</footer>
