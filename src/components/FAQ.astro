---
/**
 * FAQ — accordions built from the native <details> element (no JS). Edit under
 * `sections.faq`. Good for dress code, parking, kids, kashrut, gifts, etc.
 */
import type { FaqSection } from "../lib/types";

interface Props {
  id: string;
  data: FaqSection;
}
const { id, data } = Astro.props;
---

<section id={id} class="bg-bg py-20 sm:py-28">
  <div class="container-prose max-w-3xl">
    <div class="mb-12 text-center">
      {data.eyebrow && <p class="eyebrow mb-3">{data.eyebrow}</p>}
      {data.title && <h2 class="section-title">{data.title}</h2>}
    </div>

    <div class="divide-y divide-line border-y border-line">
      {data.items.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg text-primary">
            <span class="font-heading">{item.question}</span>
            <span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 whitespace-pre-line leading-relaxed text-muted">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
