---
/**
 * Gallery — a responsive masonry-ish grid of the couple's / family's photos.
 * Edit under `sections.gallery`. Put images in sites/<id>/visuals/gallery/ and
 * reference them as "/visuals/gallery/1.jpg".
 */
import type { GallerySection } from "../lib/types";

interface Props {
  id: string;
  data: GallerySection;
}
const { id, data } = Astro.props;
---

<section id={id} class="bg-surface py-20 sm:py-28">
  <div class="container-prose">
    <div class="mb-12 text-center">
      {data.eyebrow && <p class="eyebrow mb-3">{data.eyebrow}</p>}
      {data.title && <h2 class="section-title">{data.title}</h2>}
      {data.body && <p class="mx-auto mt-4 max-w-2xl text-muted">{data.body}</p>}
    </div>

    <div class="columns-2 gap-4 md:columns-3 [&>*]:mb-4">
      {data.images.map((img) => (
        <img
          src={img.src}
          alt={img.alt ?? ""}
          loading="lazy"
          class="w-full break-inside-avoid rounded-xl object-cover shadow-sm transition-transform duration-300 hover:scale-[1.02]"
        />
      ))}
    </div>
  </div>
</section>
