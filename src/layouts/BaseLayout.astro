---
/**
 * BaseLayout
 * ----------
 * The HTML shell shared by every page. It:
 *   - sets <html lang> and <html dir> from content.json (RTL-aware),
 *   - injects the per-site theme (colours + fonts) as CSS variables,
 *   - loads an optional custom font stylesheet,
 *   - loads the Cloudflare Turnstile script when a public site key is set.
 *
 * You should rarely need to edit this per client — personality comes from
 * theme.json and content.json.
 */
import "../styles/global.css";
import { content, theme } from "../lib/site";
import { themeCss as buildThemeCss } from "../lib/render";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ?? content.meta.title;
const pageDescription = description ?? content.meta.description ?? "";

const { language, direction } = content;
const f = theme.fonts;

// Per-site theme: turn theme.json into the `--site-*` CSS variables that
// global.css maps onto Tailwind's theme (shared with the Studio preview).
const themeCss = buildThemeCss(theme);

// Turnstile public (site) key. Exposed to the browser via the PUBLIC_ prefix.
// When empty, the forms run in DEV BYPASS mode (no widget rendered).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang={language} dir={direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content="Paperly RSVP" />
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="icon" href={content.meta.favicon ?? "/favicon.svg"} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:type" content="website" />

    <!-- Optional per-site custom fonts (e.g. a Google Fonts <link>) -->
    {f.importUrl && <link rel="stylesheet" href={f.importUrl} />}

    <!-- Per-site theme: maps theme.json onto the CSS variables used everywhere -->
    <style is:global set:html={themeCss}></style>

    {turnstileSiteKey && (
      <script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        is:inline
      ></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
