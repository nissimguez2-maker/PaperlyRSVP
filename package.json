{
  "name": "paperly-rsvp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Reusable RSVP / event website engine for Paperly. One repo, many client sites driven by JSON + visuals.",
  "scripts": {
    "css": "tailwindcss -i src/styles/global.css -o public/site.css --minify && node scripts/copy-heroui.mjs",
    "dev": "npm run css && astro dev",
    "start": "npm run dev",
    "build": "npm run css && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "dev:cf": "npm run build && wrangler pages dev dist --d1 DB --r2 MEDIA --binding ADMIN_PASSWORD=dev",
    "pages:dev": "npm run dev:cf"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@heroui/react": "^3.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^22.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
