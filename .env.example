# ---------------------------------------------------------------------------
# Paperly RSVP — environment variables
# Copy this file to ".env" for local development and fill in the values.
# On Cloudflare Pages, set these under: Settings → Environment variables.
# ---------------------------------------------------------------------------

# Which client site to build/serve. Maps to sites/<SITE_ID>/.
# Set this for BOTH the build environment and the Functions/runtime environment
# on Cloudflare so the admin page can filter submissions to this site.
SITE_ID=demo

# Production URL of the site (used for canonical links). Optional locally.
# SITE_URL=https://yourclientdomain.com

# Cloudflare Turnstile (spam protection on the public forms).
#   - PUBLIC_TURNSTILE_SITE_KEY is the public widget key (safe to expose).
#   - TURNSTILE_SECRET_KEY is the server secret (NEVER commit a real value).
# If BOTH are left empty, local development uses a DEV BYPASS so the forms
# still work without a Turnstile account. See functions/_shared.ts.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Password protecting /admin and the CSV export endpoint.
# Use HTTP Basic Auth: any username, this value as the password.
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# OPTIONAL — hosted "Publish" button in the Studio (/api/studio-save).
# Lets you (or your wife) publish design changes from the browser without git.
# Leave blank to disable; the Studio then uses local save (npm run studio) or
# Download instead. The token needs "Contents: read & write" on this repo.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=your-username/PaperlyRSVP
GITHUB_BRANCH=main
