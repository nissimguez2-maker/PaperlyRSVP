# ---------------------------------------------------------------------------
# Paperly control panel — environment variables / bindings
#
# Locally these go in ".dev.vars" (for `npm run dev:cf`). In production set them
# in the Cloudflare Pages dashboard → Settings → Environment variables, and add
# the D1 + R2 bindings under Settings → Functions.
# ---------------------------------------------------------------------------

# Password for the control panel (/admin), the admin APIs, and CSV export.
# HTTP Basic Auth: any username, this value as the password.
ADMIN_PASSWORD=change-me

# Cloudflare Turnstile (spam protection on the public RSVP/contact forms).
#   - PUBLIC_TURNSTILE_SITE_KEY: public widget key (rendered into the forms).
#   - TURNSTILE_SECRET_KEY: server secret (verification).
# If BOTH are empty, forms use a DEV BYPASS so they still work locally.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: if you make the R2 bucket public, put its base URL here so images
# are served straight from R2. Otherwise images serve via /img/<key>.
# MEDIA_BASE_URL=https://media.yourdomain.com

# Bindings (NOT secrets — configured in wrangler.toml + the Pages dashboard):
#   DB     → D1 database  "paperly-rsvp"   (sites + submissions)
#   MEDIA  → R2 bucket     "paperly-media"  (HD images)
